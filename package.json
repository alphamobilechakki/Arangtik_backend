{
  "name": "arangtik-backend",
  "version": "1.0.0",
  "description": "Backend API for Arangtik - AI Powered Wardrobe, Laundry & Household Management",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:coins": "node scripts/seedCoinPackages.js",
    "seed:plans": "node scripts/seedSubscriptionPlans.js",
    "test": "node --test tests/*.test.js",
    "test:load:tokens": "node tests/loadtesting/utils/generateTokens.js",
    "test:load:smoke": "node tests/loadtesting/utils/generateTokens.js && \"C:\\Program Files\\k6\\k6.exe\" run tests/loadtesting/scenarios/smoke_test.js",
    "test:load:100": "node tests/loadtesting/utils/generateTokens.js && \"C:\\Program Files\\k6\\k6.exe\" run --vus 100 --duration 30s tests/loadtesting/scenarios/smoke_test.js",
    "test:load:all": "node tests/loadtesting/utils/generateTokens.js && \"C:\\Program Files\\k6\\k6.exe\" run tests/loadtesting/scenarios/load_test.js",
    "test:load:jewellery": "node tests/loadtesting/utils/generateTokens.js && \"C:\\Program Files\\k6\\k6.exe\" run tests/loadtesting/features/jewellery/jewellery_user.js",
    "test:load:jewellery:admin": "node tests/loadtesting/utils/generateTokens.js && \"C:\\Program Files\\k6\\k6.exe\" run tests/loadtesting/features/jewellery/jewellery_admin.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "wardrobe",
    "laundry",
    "inventory",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.7.8",
    "colord": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "braces": "^3.0.3",
    "zod": "^3.23.8",
    "sprintf-js": "^1.1.3"
  }
}
