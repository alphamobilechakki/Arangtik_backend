# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/arangtik

# JWT Authentication
JWT_SECRET=arangtik_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
ADMIN_SYNC_API_KEY=sk_live_sample_secret_key_for_external_sync

# ==========================
# OTP Configuration
# ==========================
OTP_EXPIRY=10
OTP_DEV_MODE=false

# ==========================
# API24 WhatsApp OTP Gateway
# ==========================
API24_BASE_URL=https://api24.in/api/v1
API24_API_KEY=your_api24_api_key
API24_API_SECRET=your_api24_api_secret
API24_CHANNEL_ID=your_api24_channel_id
API24_TEMPLATE=otp_verify_code
API24_LANGUAGE=en_US
API24_PHONE_NUMBER=919468544119

# File Upload / Cloudinary (Optional / Future)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI API Keys (Optional / Future)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key


# ==========================
# Firebase Cloud Messaging (FCM HTTP v1)
# ==========================
# Option A: Path to service account json file (Recommended for development/local server)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Option B: Individual Service Account Credentials (Ideal for Docker / Cloud Env)
FIREBASE_PROJECT_ID=arangtik-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@arangtik-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option C: Base64 Encoded Service Account JSON (Alternative for CI/CD)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# FCM Mock / Dry-Run Mode (Set true to test flows without real Firebase keys)
FCM_DEV_MODE=false

